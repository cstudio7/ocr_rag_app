# Copy this file to .env and adjust the values. Never commit your real .env.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Development settings
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=9123

# Optional: defaults to SQLite at backend/data/app.db
# DATABASE_URL=sqlite:////absolute/path/to/app.db

# Admin account created on first run (change the password after logging in)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-too
